@startuml AlbumSnapUseCases

title AlbumSnap - Use Case Diagram

skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}
skinparam ArrowColor #444444
left to right direction

actor "User" as U
actor "Spotify" as SP <<external system>>
actor "Google Cloud Vision" as GV <<external system>>
actor "Deezer" as DZ <<external system>>

rectangle "AlbumSnap" {

  usecase "UC1\nLog in with Spotify" as UC1

  usecase "UC3\nScan album cover" as UC3
  usecase "Capture cover photo" as UC3a
  usecase "Recognize album\nfrom photo" as UC3b
  usecase "Search albums\non Spotify" as UC3c
  usecase "Choose album from\ncandidate list" as UC3d

  usecase "UC4\nView album details" as UC4
  usecase "UC5\nPreview track (30 s)" as UC5
  usecase "UC6\nSave album to Library" as UC6
  usecase "UC7\nRemove album from Library" as UC7
  usecase "UC8\nAdd album to\nSpotify favourites" as UC8

  usecase "UC9\nBrowse Library" as UC9
  usecase "UC10\nView recent scans" as UC10

  usecase "UC11\nChange theme" as UC11
  usecase "UC12\nChange language" as UC12
}

U --> UC1
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11
U --> UC12

UC3 ..> UC3a : <<include>>
UC3 ..> UC3b : <<include>>
UC3 ..> UC3c : <<include>>
UC3d .> UC3 : <<extend>>\n[more than one candidate]
UC3 ..> UC4 : <<include>>

UC9 ..> UC4 : <<extend>>\n[user taps album]
UC10 ..> UC4 : <<extend>>\n[user taps album]
UC5 .> UC4 : <<extend>>
UC6 .> UC4 : <<extend>>
UC7 .> UC4 : <<extend>>
UC8 .> UC4 : <<extend>>

UC1 --> SP
UC3b --> GV
UC3c --> SP
UC4 --> SP
UC5 --> DZ
UC8 --> SP

note as N1
  All use cases except UC1 require an authenticated
  Spotify session (otherwise the app shows UC1).
end note

@enduml
