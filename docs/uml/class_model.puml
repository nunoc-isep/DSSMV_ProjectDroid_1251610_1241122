@startuml
title AlbumSnap - Model, DTOs and mapping
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle folder
skinparam defaultFontSize 11
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #444444
skinparam ArrowColor #444444
skinparam nodesep 18
skinparam ranksep 32
hide empty members


package "model" {
    class Album {
      - spotifyId: String
      - title: String
      - releaseDate: String
      - totalTracks: int
      - albumType: String
      - coverUrl: String
      - artists: List<Artist>
      - tracks: List<Track>
      + getArtistNames(): String
      + getReleaseYear(): String
      + setTracks(tracks: List<Track>): void
    }
    class Artist {
      - spotifyId: String
      - name: String
    }
    class Track {
      - spotifyId: String
      - title: String
      - durationMs: long
      - trackNumber: int
      - discNumber: int
      - artists: List<Artist>
    }
    class Playlist {
      - spotifyId: String
      - name: String
    }
    class PreviewQuery {
      - isrc: String
      - title: String
      - artists: List<String>
      - albumTitle: String
      - durationMs: long
      + getPrimaryArtist(): String
    }
}
package "dto" {
    class JsonUtil <<package-private>> {
      ~ {static} str(o: JSONObject, key: String): String
    }
    class AlbumDTO {
      - id: String
      - name: String
      - releaseDate: String
      - totalTracks: int
      - albumType: String
      - coverUrl: String
      + {static} fromJson(o: JSONObject): AlbumDTO
      + {static} tracksFromItems(items: JSONArray): List<TrackDTO>
    }
    class TrackDTO {
      - id: String
      - name: String
      - durationMs: long
      - trackNumber: int
      - discNumber: int
      + {static} fromJson(o: JSONObject): TrackDTO
    }
    class ArtistDTO {
      - id: String
      - name: String
      + {static} fromJson(o: JSONObject): ArtistDTO
    }
    class VisionResponseDTO {
      - responses: List<AnnotateImageResponse>
    }
    class AnnotateImageResponse {
      - fullTextAnnotation: FullTextAnnotation
      - webDetection: WebDetection
    }
    class FullTextAnnotation {
      - text: String
    }
    class WebDetection {
      - webEntities: List<WebEntity>
      - bestGuessLabels: List<BestGuessLabel>
      - pagesWithMatchingImages: List<WebPage>
      - fullMatchingImages: List<WebImage>
      - partialMatchingImages: List<WebImage>
    }
    class WebEntity {
      - description: String
      - score: float
    }
    class BestGuessLabel {
      - label: String
    }
    class WebPage {
      - url: String
      - pageTitle: String
      - fullMatchingImages: List<WebImage>
      - partialMatchingImages: List<WebImage>
    }
    class WebImage {
      - url: String
    }
}
package "external" {
    class AlbumMapper <<package-private>> {
      ~ {static} toDomain(dto: AlbumDTO): Album
      ~ {static} toDomainTracks(dtos: List<TrackDTO>): List<Track>
    }
}

Album "1" *-- "0..*" Track
Album "0..*" o-- "1..*" Artist
Track "0..*" o-- "0..*" Artist
AlbumDTO "1" o-- "0..*" ArtistDTO
AlbumDTO "1" o-- "0..*" TrackDTO
TrackDTO "1" o-- "0..*" ArtistDTO
AlbumDTO ..> JsonUtil
TrackDTO ..> JsonUtil
ArtistDTO ..> JsonUtil
AlbumMapper ..> AlbumDTO
AlbumMapper ..> TrackDTO
AlbumMapper ..> Album
AlbumMapper ..> Track
VisionResponseDTO "1" *-- "0..*" AnnotateImageResponse
AnnotateImageResponse "1" *-- "0..1" FullTextAnnotation
AnnotateImageResponse "1" *-- "0..1" WebDetection
WebDetection "1" *-- "0..*" WebEntity
WebDetection "1" *-- "0..*" BestGuessLabel
WebDetection "1" *-- "0..*" WebPage
WebDetection "1" *-- "0..*" WebImage
WebPage "1" *-- "0..*" WebImage
@enduml
