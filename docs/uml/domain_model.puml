@startuml

title AlbumSnap - Domain Model

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #444444
skinparam ArrowColor #444444
skinparam defaultFontSize 11
hide empty members

' =========================
' USER AND ACCOUNT
' =========================
class User {
}

class SpotifyAccount {
  - accessToken: String
  - refreshToken: String
  - tokenExpiresAt: DateTime
}

class AppSettings {
  - theme: ThemeMode
  - language: Language
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum Language {
  SYSTEM
  ENGLISH
  PORTUGUESE
}

' =========================
' SCANNING
' =========================
class AlbumScan {
  - scannedAt: DateTime
  - detectedText: String
}

class AlbumCoverPhoto {
  - capturedAt: DateTime
}

' =========================
' CATALOGUE
' =========================
class Album {
  - spotifyId: String
  - title: String
  - releaseDate: String
  - totalTracks: int
  - albumType: String
  - coverUrl: String
}

class Artist {
  - spotifyId: String
  - name: String
}

class Track {
  - spotifyId: String
  - title: String
  - durationMs: long
  - trackNumber: int
  - discNumber: int
  - isrc: String
}

class TrackPreview {
  - audioUrl: String
  - lengthSeconds: int = 30
}

' =========================
' PERSONAL COLLECTION
' =========================
class Library {
}

class LibraryEntry {
  - savedAt: DateTime
}

class Playlist {
  - spotifyId: String
  - name: String
}

' =========================
' RELATIONSHIPS
' =========================
User "1" -- "0..1" SpotifyAccount : connects
User "1" -- "1" AppSettings : configures
AppSettings --> ThemeMode
AppSettings --> Language

User "1" -- "0..*" AlbumScan : performs
AlbumScan "1" *-- "1" AlbumCoverPhoto : captures
AlbumScan "0..*" --> "0..*" Album : candidates found
AlbumScan "0..*" --> "0..1" Album : chosen album

Album "0..*" -- "1..*" Artist : credited to
Album "1" *-- "1..*" Track : contains
Track "0..*" -- "1..*" Artist : performed by
Track "1" -- "0..1" TrackPreview : has

User "1" -- "1" Library : owns
Library "1" *-- "0..*" LibraryEntry : stores
LibraryEntry "0..*" --> "1" Album : refers to

SpotifyAccount "0..*" -- "0..*" Album : saved albums
SpotifyAccount "0..*" -- "0..*" Track : liked songs
SpotifyAccount "1" -- "0..*" Playlist : owns or\ncollaborates on
Playlist "0..*" -- "0..*" Track : receives

note bottom of AlbumScan
  The 10 most recent scans (with a chosen album)
  form the "Recent" list on the main menu.
end note

note bottom of TrackPreview
  Comes from Deezer (looked up by ISRC) or,
  if Deezer does not have the recording, from
  iTunes. Since Nov 2024 Spotify restricts its own
  30 s preview URLs for new apps.
end note

note right of Track
  The ISRC identifies the exact recording.
  It is only obtained when a preview is
  requested (GET /tracks/{id}).
end note

note right of Library
  The Library is local to the app
  (SQLite) and independent from the
  Spotify account.
end note

@enduml
