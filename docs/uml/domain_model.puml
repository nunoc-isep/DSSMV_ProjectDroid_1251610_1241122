@startuml AlbumSnapDomainModel

title AlbumSnap - Domain Model

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #444444
skinparam ArrowColor #444444

' =========================
' USER AND ACCOUNT
' =========================
class User {
}

class SpotifyAccount {
  - spotifyUserId: String
  - accessToken: String
  - refreshToken: String
  - tokenExpiresAt: DateTime
}

class AppSettings {
  - theme: ThemeMode
  - language: Language
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum Language {
  SYSTEM
  ENGLISH
  PORTUGUESE
}

' =========================
' SCANNING
' =========================
class AlbumScan {
  - scannedAt: DateTime
  - detectedText: String
}

class AlbumCoverPhoto {
  - capturedAt: DateTime
  - imageUri: String
}

' =========================
' CATALOGUE
' =========================
class Album {
  - spotifyId: String
  - title: String
  - releaseDate: String
  - totalTracks: int
  - albumType: String
  - coverUrl: String
}

class Artist {
  - spotifyId: String
  - name: String
}

class Track {
  - spotifyId: String
  - title: String
  - durationMs: long
  - trackNumber: int
}

class TrackPreview {
  - audioUrl: String
  - lengthSeconds: int = 30
}

' =========================
' PERSONAL COLLECTION
' =========================
class Library {
}

class LibraryEntry {
  - savedAt: DateTime
}

' =========================
' RELATIONSHIPS
' =========================
User "1" -- "0..1" SpotifyAccount : connects
User "1" -- "1" AppSettings : configures
AppSettings --> ThemeMode
AppSettings --> Language

User "1" -- "0..*" AlbumScan : performs
AlbumScan "1" *-- "1" AlbumCoverPhoto : captures
AlbumScan "0..*" --> "0..*" Album : candidates found
AlbumScan "0..*" --> "0..1" Album : chosen album

Album "0..*" -- "1..*" Artist : credited to
Album "1" *-- "0..*" Track : contains
Track "1" -- "0..1" TrackPreview : has

User "1" -- "1" Library : owns
Library "1" *-- "0..*" LibraryEntry : stores
LibraryEntry "0..*" --> "1" Album : refers to

SpotifyAccount "0..*" -- "0..*" Album : favourites

note bottom of AlbumScan
  The 10 most recent scans (with a chosen album)
  form the "Recent" list on the main menu.
end note

note bottom of TrackPreview
  Comes from Deezer, not Spotify,
  because Spotify no longer returns
  preview_url to new apps.
end note

note right of Library
  The Library is local to the app
  (SQLite) and independent from the
  Spotify favourites.
end note

@enduml
