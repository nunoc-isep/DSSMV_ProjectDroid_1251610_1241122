@startuml
title AlbumSnap - Contracts (services and repository) and their implementations
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle folder
skinparam defaultFontSize 11
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #444444
skinparam ArrowColor #444444
skinparam nodesep 18
skinparam ranksep 32
hide empty members
left to right direction


package "services" {
    interface AlbumSearchService {
      + searchAlbums(query: String): List<Album>
      + getAlbumDetails(spotifyId: String): Album
    }
    interface ImageRecognitionService {
      + analyzeImage(bitmap: Bitmap, cb: VisionCallback): void
    }
    interface "ImageRecognitionService.VisionCallback" as VisionCallback {
      + onSuccess(jsonResult: String): void
      + onError(e: Exception): void
    }
    interface SpotifyAuthService {
      + authorize(): void
      + getAccessToken(): String
      + isAuthenticated(): boolean
      + disconnect(): void
    }
    interface FavouriteAlbumService {
      + addAlbum(spotifyId: String): void
    }
    interface FavouriteTrackService {
      + addTrack(spotifyId: String): void
    }
    interface PlaylistService {
      + getEditablePlaylists(): List<Playlist>
      + addTrack(playlistId: String, trackId: String): void
    }
    interface TrackInfoService {
      + getIsrc(trackSpotifyId: String): String
    }
    interface PreviewService {
      + findPreviewUrl(query: PreviewQuery): String
    }
}
package "repository" {
    interface AlbumRepository {
      + findBySpotifyId(spotifyId: String): Album
    }
    interface LocalAlbumRepository {
      + saveToLibrary(album: Album): void
      + removeFromLibrary(spotifyId: String): void
      + isInLibrary(spotifyId: String): boolean
      + getLibrary(): List<Album>
      + addRecentScan(album: Album): void
      + getRecentScans(limit: int): List<Album>
    }
}
package "external" {
    class GoogleCloudVisionService #E4E4E4
    class SpotifyAlbumSearchService #E4E4E4
    class SpotifyAuthManager #E4E4E4
    class SpotifyFavouriteAlbumService #E4E4E4
    class SpotifyFavouriteTrackService #E4E4E4
    class SpotifyPlaylistService #E4E4E4
    class SpotifyTrackInfoService #E4E4E4
    class DeezerPreviewService #E4E4E4
    class ItunesPreviewService #E4E4E4
    class CompositePreviewService #E4E4E4
    class SpotifyAlbumRepository #E4E4E4
}
package "storage" {
    class SqliteAlbumRepository #E4E4E4
}

ImageRecognitionService +-- VisionCallback
GoogleCloudVisionService ..|> ImageRecognitionService
SpotifyAlbumSearchService ..|> AlbumSearchService
SpotifyAuthManager ..|> SpotifyAuthService
SpotifyFavouriteAlbumService ..|> FavouriteAlbumService
SpotifyFavouriteTrackService ..|> FavouriteTrackService
SpotifyPlaylistService ..|> PlaylistService
SpotifyTrackInfoService ..|> TrackInfoService
DeezerPreviewService ..|> PreviewService
ItunesPreviewService ..|> PreviewService
CompositePreviewService ..|> PreviewService
SpotifyAlbumRepository ..|> AlbumRepository
SqliteAlbumRepository ..|> LocalAlbumRepository
@enduml
