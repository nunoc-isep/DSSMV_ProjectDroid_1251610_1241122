@startuml
title AlbumSnap - Component diagram (logical architecture)
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 22
skinparam ranksep 48
skinparam ArrowColor #444444
skinparam component {
  BackgroundColor #FDFDFD
  BorderColor #444444
}
skinparam cloud {
  BackgroundColor #F1F5FB
  BorderColor #44556F
}

component "Views\n6 Activities + adapters" as V
component "Controllers\nAlbumController, LibraryController,\nCameraController" as C

interface "SpotifyAuthService" as IAuth
interface "AlbumRepository" as IRepo
interface "AlbumSearchService" as ISearch
interface "Favourite*Service\nPlaylistService\nTrackInfoService" as IFav
interface "ImageRecognitionService" as IVis
interface "PreviewService" as IPrev
interface "LocalAlbumRepository" as ILocal

component "Spotify access\nSpotifyAuthManager, SpotifyApiClient,\nSpotifyAlbumRepository, SpotifyAlbumSearchService,\nSpotifyFavourite*Service, SpotifyPlaylistService,\nSpotifyTrackInfoService" as SP
component "Cover recognition\nGoogleCloudVisionService\n(+ SearchQuery, AlbumMatcher)" as REC
component "Track previews\nCompositePreviewService,\nDeezerPreviewService, ItunesPreviewService\n(+ PreviewMatcher)" as PRV
component "Local storage\nSqliteAlbumRepository,\nAlbumDbHelper, SettingsManager" as ST

cloud "Spotify\naccounts + Web API" as XS
cloud "Google\nCloud Vision" as XG
cloud "Deezer\nAPI" as XD
cloud "iTunes\nSearch API" as XI
database "SQLite +\nSharedPreferences" as XL

V --> C
C ..> IRepo
C ..> ISearch
C ..> IFav
C ..> IVis
C ..> IPrev
C ..> ILocal
V ..> IAuth : login / logout

SP -up- IAuth
SP -up- IRepo
SP -up- ISearch
SP -up- IFav
REC -up- IVis
PRV -up- IPrev
ST -up- ILocal
V ..> ST : theme, language

SP --> XS
REC --> XG
PRV --> XD
PRV --> XI
ST --> XL

note bottom of ST
  All components use the shared
  model/dto packages (Album, Track, ...)
end note
@enduml
