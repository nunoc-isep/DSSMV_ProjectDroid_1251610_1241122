@startuml
title AlbumSnap - Class Diagram (as implemented)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle folder
skinparam defaultFontSize 11
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #444444
skinparam ArrowColor #444444
skinparam nodesep 18
skinparam ranksep 32
hide empty members


package "model" {
    class Album {
      - spotifyId: String
      - title: String
      - releaseDate: String
      - totalTracks: int
      - albumType: String
      - coverUrl: String
      - artists: List<Artist>
      - tracks: List<Track>
      + getArtistNames(): String
      + getReleaseYear(): String
      + setTracks(tracks: List<Track>): void
    }
    class Artist {
      - spotifyId: String
      - name: String
    }
    class Track {
      - spotifyId: String
      - title: String
      - durationMs: long
      - trackNumber: int
      - discNumber: int
      - artists: List<Artist>
    }
    class Playlist {
      - spotifyId: String
      - name: String
    }
    class PreviewQuery {
      - isrc: String
      - title: String
      - artists: List<String>
      - albumTitle: String
      - durationMs: long
      + getPrimaryArtist(): String
    }
}
package "dto" {
    class JsonUtil <<package-private>> {
      ~ {static} str(o: JSONObject, key: String): String
    }
    class AlbumDTO {
      - id: String
      - name: String
      - releaseDate: String
      - totalTracks: int
      - albumType: String
      - coverUrl: String
      + {static} fromJson(o: JSONObject): AlbumDTO
      + {static} tracksFromItems(items: JSONArray): List<TrackDTO>
    }
    class TrackDTO {
      - id: String
      - name: String
      - durationMs: long
      - trackNumber: int
      - discNumber: int
      + {static} fromJson(o: JSONObject): TrackDTO
    }
    class ArtistDTO {
      - id: String
      - name: String
      + {static} fromJson(o: JSONObject): ArtistDTO
    }
    class VisionResponseDTO {
      - responses: List<AnnotateImageResponse>
    }
    class AnnotateImageResponse {
      - fullTextAnnotation: FullTextAnnotation
      - webDetection: WebDetection
    }
    class FullTextAnnotation {
      - text: String
    }
    class WebDetection {
      - webEntities: List<WebEntity>
      - bestGuessLabels: List<BestGuessLabel>
      - pagesWithMatchingImages: List<WebPage>
      - fullMatchingImages: List<WebImage>
      - partialMatchingImages: List<WebImage>
    }
    class WebEntity {
      - description: String
      - score: float
    }
    class BestGuessLabel {
      - label: String
    }
    class WebPage {
      - url: String
      - pageTitle: String
      - fullMatchingImages: List<WebImage>
      - partialMatchingImages: List<WebImage>
    }
    class WebImage {
      - url: String
    }
}
package "external" {
    class AlbumMapper <<package-private>> {
      ~ {static} toDomain(dto: AlbumDTO): Album
      ~ {static} toDomainTracks(dtos: List<TrackDTO>): List<Track>
    }
    class GoogleCloudVisionService {
      + analyzeImage(bitmap: Bitmap, cb: VisionCallback): void
      + {static} parseSearchQueries(json: String): List<String>
      + {static} parseSpotifyAlbumIds(json: String): List<String>
      + {static} parseCoverKeys(json: String): Set<String>
      + {static} describeResponse(json: String): String
      - buildRequestBodyJson(base64: String): JSONObject
      - prepareForUpload(src: Bitmap): Bitmap
    }
    class SpotifyAlbumSearchService {
      + searchAlbums(query: String): List<Album>
      + getAlbumDetails(spotifyId: String): Album
    }
    class SpotifyTrackInfoService {
      + getIsrc(trackSpotifyId: String): String
    }
    class DeezerPreviewService {
      + findPreviewUrl(query: PreviewQuery): String
      - searchBest(q: String, query: PreviewQuery): String
      - getOrNull(address: String): JSONObject
    }
    class ItunesPreviewService {
      + findPreviewUrl(query: PreviewQuery): String
    }
    class CompositePreviewService {
      + CompositePreviewService(sources: PreviewService...)
      + findPreviewUrl(query: PreviewQuery): String
    }
    class JsonHttp <<package-private>> {
      ~ {static} get(address: String): JSONObject
      ~ {static} text(o: JSONObject, key: String): String
      ~ {static} secure(url: String): String
    }
    class SpotifyAuthManager {
      + {static} CLIENT_ID: String
      + {static} REDIRECT_URI: String = "albumsnap://callback"
      + {static} getInstance(ctx: Context): SpotifyAuthManager
      + authorize(): void
      + handleRedirect(data: Uri, cb: LoginCallback): boolean
      + isAuthenticated(): boolean
      + getAccessToken(): String
      + refreshAccessToken(): String
      + disconnect(): void
      ~ {static} challengeFor(verifier: String): String
    }
    interface "SpotifyAuthManager.LoginCallback" as LoginCallback {
      + onSuccess(): void
      + onError(message: String): void
    }
    class SpotifyApiClient {
      + {static} BASE_URL: String = "https://api.spotify.com/v1"
      + get(pathAndQuery: String): JSONObject
      + post(pathAndQuery: String, body: JSONObject): void
      + put(pathAndQuery: String, body: JSONObject): void
      + saveToLibrary(uri: String): void
      - request(method: String, path: String, body: byte[]): String
    }
    class "SpotifyApiClient.ApiException" as ApiException {
      + getStatus(): int
    }
    class SpotifyAlbumRepository {
      + findBySpotifyId(spotifyId: String): Album
    }
    class SpotifyFavouriteAlbumService {
      + addAlbum(spotifyId: String): void
    }
    class SpotifyFavouriteTrackService {
      + addTrack(spotifyId: String): void
    }
    class SpotifyPlaylistService {
      + getEditablePlaylists(): List<Playlist>
      + addTrack(playlistId: String, trackId: String): void
    }
}
package "services" {
    interface AlbumSearchService {
      + searchAlbums(query: String): List<Album>
      + getAlbumDetails(spotifyId: String): Album
    }
    interface ImageRecognitionService {
      + analyzeImage(bitmap: Bitmap, cb: VisionCallback): void
    }
    interface "ImageRecognitionService.VisionCallback" as VisionCallback {
      + onSuccess(jsonResult: String): void
      + onError(e: Exception): void
    }
    interface SpotifyAuthService {
      + authorize(): void
      + getAccessToken(): String
      + isAuthenticated(): boolean
      + disconnect(): void
    }
    interface FavouriteAlbumService {
      + addAlbum(spotifyId: String): void
    }
    interface FavouriteTrackService {
      + addTrack(spotifyId: String): void
    }
    interface PlaylistService {
      + getEditablePlaylists(): List<Playlist>
      + addTrack(playlistId: String, trackId: String): void
    }
    interface TrackInfoService {
      + getIsrc(trackSpotifyId: String): String
    }
    interface PreviewService {
      + findPreviewUrl(query: PreviewQuery): String
    }
}
package "repository" {
    interface AlbumRepository {
      + findBySpotifyId(spotifyId: String): Album
    }
    interface LocalAlbumRepository {
      + saveToLibrary(album: Album): void
      + removeFromLibrary(spotifyId: String): void
      + isInLibrary(spotifyId: String): boolean
      + getLibrary(): List<Album>
      + addRecentScan(album: Album): void
      + getRecentScans(limit: int): List<Album>
    }
}
package "controllers" {
    class CameraController {
      + CameraController(ctx: Context)
      ~ CameraController(search: AlbumSearchService, vision: ImageRecognitionService)
      + processCapturedImage(photo: Bitmap, cb: CameraCallback): void
      + cancel(): void
      - searchAndRank(queries: List<String>, ids: List<String>, keys: Set<String>): Outcome
    }
    interface "CameraController.CameraCallback" as CameraCallback {
      + onStatusUpdate(statusRes: int): void
      + onAlbumsRecognized(albums: List<Album>): void
      + onError(messageRes: int, detail: String): void
    }
    class AlbumController {
      + {static} create(ctx: Context): AlbumController
      + getAlbum(id: String, cb: Callback<Album>): void
      + registerScan(album: Album): void
      + isInLibrary(id: String, cb: Callback<Boolean>): void
      + saveToLibrary(album: Album, cb: Callback<Boolean>): void
      + removeFromLibrary(id: String, cb: Callback<Boolean>): void
      + addToSpotifyFavourites(id: String, cb: Callback<Boolean>): void
      + addTrackToSpotifyFavourites(id: String, cb: Callback<Boolean>): void
      + getEditablePlaylists(cb: Callback<List<Playlist>>): void
      + addTrackToPlaylist(pl: String, track: String, cb: Callback<Boolean>): void
      + getPreviewUrl(album: Album, track: Track, cb: Callback<String>): void
    }
    class LibraryController {
      + {static} create(ctx: Context): LibraryController
      + getLibraryAlbums(cb: Callback<List<Album>>): void
      + getRecentScans(cb: Callback<List<Album>>): void
    }
}
package "util" {
    class SearchQuery <<utility>> {
      + {static} clean(raw: String): String
      + {static} isGeneric(cleaned: String): boolean
      + {static} isMeaningfulText(cleaned: String): boolean
      + {static} fromPageTitle(title: String): String
      + {static} isMusicSite(url: String): boolean
      + {static} spotifyAlbumId(url: String): String
      + {static} spotifyCoverKey(url: String): String
      + {static} firstWords(text: String, n: int): String
      + {static} wordCount(text: String): int
    }
    class AlbumMatcher <<utility>> {
      + {static} CONFIDENT_SCORE: double = 0.95
      + {static} CONFIDENT_GAP: double = 0.30
      + {static} rank(albums: List<Album>, queries: List<String>): List<Album>
      + {static} isConfident(ranked: List<Album>, queries: List<String>): boolean
      + {static} score(album: Album, queries: List<String>): double
    }
    class PreviewMatcher <<utility>> {
      + {static} DURATION_TOLERANCE_MS: long = 5000
      + {static} score(query: PreviewQuery, title: String, artist: String,\n    album: String, durationMs: long): int
      + {static} isMatch(query: PreviewQuery, title: String,\n    artist: String, durationMs: long): boolean
      + {static} cleanTitle(title: String): String
      + {static} normalize(text: String): String
    }
    class PreviewPlayer {
      + play(url: String): void
      + pause(): void
      + stop(): void
      + release(): void
      + isPlaying(): boolean
      + isPaused(): boolean
    }
    interface "PreviewPlayer.Listener" as PlayerListener {
      + onPlaying(): void
      + onPaused(): void
      + onFinished(): void
      + onError(): void
    }
    class ErrorMessages <<utility>> {
      + {static} NETWORK: String
      + {static} NO_SESSION: String
      + {static} SESSION_EXPIRED: String
      + {static} SPOTIFY_FORBIDDEN: String
      + {static} SPOTIFY_NOT_FOUND: String
      + {static} SPOTIFY_RATE_LIMIT: String
      + {static} spotifyHttp(status: int): String
      + {static} localize(ctx: Context, message: String): String
    }
    class Background <<utility>> {
      + {static} run(task: Task<T>, cb: Callback<T>): void
    }
    interface "Callback<T>" as CallbackI {
      + onResult(result: T): void
      + onError(message: String): void
    }
    class ImageLoader <<utility>> {
      + {static} load(url: String, target: ImageView, placeholder: int, sizePx: int): void
    }
    class EdgeInsets <<utility>> {
      + {static} applyTo(root: View): void
    }
}
package "storage" {
    class SqliteAlbumRepository {
      + saveToLibrary(album: Album): void
      + removeFromLibrary(spotifyId: String): void
      + isInLibrary(spotifyId: String): boolean
      + getLibrary(): List<Album>
      + addRecentScan(album: Album): void
      + getRecentScans(limit: int): List<Album>
      - upsert(album: Album, extra: ContentValues): void
    }
    class AlbumDbHelper {
      + {static} TABLE: String = "albums"
      + onCreate(db: SQLiteDatabase): void
      + onUpgrade(db: SQLiteDatabase, oldV: int, newV: int): void
    }
    class SettingsManager {
      + {static} THEME_SYSTEM / THEME_LIGHT / THEME_DARK: String
      + {static} LANGUAGE_SYSTEM / LANGUAGE_EN / LANGUAGE_PT: String
      + {static} from(ctx: Context): SettingsManager
      + getTheme(): String
      + setTheme(theme: String): void
      + getLanguage(): String
      + setLanguage(language: String): void
      + applyTheme(): void
      + applyLanguage(): void
      + applyAll(): void
    }
}
package "views" {
    class LoginActivity {
      # onCreate(savedInstanceState: Bundle): void
      # onNewIntent(intent: Intent): void
      - displayLogin(): void
      - connectSpotify(): void
      - showConnectionStatus(connected: boolean): void
      - handleIntent(intent: Intent): void
    }
    class MainMenuActivity {
      # onCreate(savedInstanceState: Bundle): void
      # onResume(): void
      - loadRecent(): void
      - setExpanded(value: boolean): void
      - renderRecent(): void
      - openAlbum(album: Album): void
      - goToLogin(): void
    }
    class CameraActivity {
      # onCreate(savedInstanceState: Bundle): void
      # onSaveInstanceState(outState: Bundle): void
      - checkPermissionAndOpenCamera(): void
      - openCamera(): void
      - deleteTempPhoto(): void
      - purgeOldPhotos(): void
      - deleteMatching(dir: File): void
      - loadBitmapFromUri(uri: Uri): Bitmap
      - applyExifRotation(bitmap: Bitmap, uri: Uri): Bitmap
      - isActivityAlive(): boolean
      - leaveScreen(): void
      # onDestroy(): void
      - processImage(bitmap: Bitmap): void
      - showAlbumBottomSheet(albums: List<Album>): void
      - openAlbumDetails(album: Album): void
    }
    class AlbumActivity {
      # onCreate(savedInstanceState: Bundle): void
      - loadAlbum(): void
      - displayAlbum(a: Album): void
      - buildInfoLine(a: Album): String
      - typeLabel(albumType: String): String
      - updateLibraryButton(): void
      - toggleLibrary(): void
      - addToSpotifyFavourites(): void
      - onTrackMenuClick(track: Track, anchor: View): void
      - addTrackToFavourites(track: Track): void
      - chooseAndAddToPlaylist(track: Track): void
      - showPlaylistPicker(track: Track, playlists: List<Playlist>): void
      - addTrackToPlaylist(track: Track, playlist: Playlist, playlistName: String): void
      - showToastError(message: String): void
      - onPreviewClick(track: Track): void
      - startPreview(url: String): void
      - stopPreview(): void
      # onStop(): void
      # onDestroy(): void
      - showError(message: String): void
    }
    class LibraryActivity {
      # onCreate(savedInstanceState: Bundle): void
      # onResume(): void
      - openAlbum(album: Album): void
    }
    class SettingsActivity {
      # onCreate(savedInstanceState: Bundle): void
      - logout(): void
      - {static} themeToId(theme: String): int
      - {static} idToTheme(id: int): String
      - {static} languageToId(language: String): int
      - {static} idToLanguage(id: int): String
    }
}
package "views.adapters" {
    class AlbumAdapter {
      + setItems(items: List<Album>): void
      + getView(pos: int, v: View, parent: ViewGroup): View
    }
    interface "AlbumAdapter.Listener" as AlbumListener {
      + onInfoClicked(album: Album): void
    }
    class TrackAdapter {
      + setItems(tracks: List<Track>): void
      + setOnPreviewClickListener(l: OnPreviewClickListener): void
      + setOnTrackMenuClickListener(l: OnTrackMenuClickListener): void
      + setPreviewState(trackId: String, state: PreviewState): void
      + getView(pos: int, v: View, parent: ViewGroup): View
    }
    enum PreviewState {
      IDLE
      LOADING
      PLAYING
    }
    interface OnPreviewClickListener {
      + onPreviewClick(track: Track): void
    }
    interface OnTrackMenuClickListener {
      + onTrackMenuClick(track: Track, anchor: View): void
    }
}
class AlbumSnapApplication {
  + onCreate(): void
}

