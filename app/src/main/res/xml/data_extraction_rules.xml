<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras do backup na nuvem e da transferencia entre telemoveis (Android 12 e posteriores).
   Os tokens do Spotify (ficheiro "spotify_auth") ficam de fora dos dois; o resto continua a ser copiado.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </device-transfer>
</data-extraction-rules>
