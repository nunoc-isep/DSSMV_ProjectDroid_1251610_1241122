<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras do backup automatico (Android 11 e anteriores).
   O que nao esta aqui continua a ser guardado (Library, scans recentes, definicoes).
   Os tokens do Spotify (SpotifyAuthManager, ficheiro "spotify_auth") ficam de fora: dao acesso
   a conta do utilizador e, num telemovel novo, ele so tem de fazer login outra vez.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="spotify_auth.xml" />
</full-backup-content>
